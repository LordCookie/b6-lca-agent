# Copy to .env and fill in. .env is gitignored and dockerignored.
# The key is passed to containers via env_file in docker-compose.yml,
# never baked into the image.

OPENROUTER_API_KEY=

# Optional overrides
APP_LOG_LEVEL=INFO
APP_RUN_BASE_DIR=/app/runs
OEKOBAUDAT_API_BASE=https://oekobaudat.de/OEKOBAU.DAT/resource
OEKOBAUDAT_DB_VERSION=2024-I

# Long-running step timeouts (seconds). Tune as needed.
TIMEOUT_OSM_FETCH=900
TIMEOUT_DEEPNESS_INFER=1800
TIMEOUT_OEKOBAUDAT=300
TIMEOUT_LLM_CALL=180

# Research agent: LLM-Recherche mit openrouter:web_search Server-Tool.
# Default an, weil das Tool Quellen-Disziplin (spec §10) durch URL-Pflicht
# durchsetzt. Auf false setzen, um den deterministischen Pfad zu erzwingen.
RESEARCH_LLM_FALLBACK=true
RESEARCH_LLM_MAX_CALLS_PER_RUN=10

# Eigene Web-Suche (schlüsselloses DuckDuckGo) statt OpenRouters Server-Tool.
# Liefert echte zitierbare URLs; der LLM extrahiert nur noch daraus (Spec §10).
WEB_SEARCH_PROVIDER=duckduckgo
WEB_SEARCH_MAX_RESULTS=5
WEB_SEARCH_REGION=de-de

# Vegetations-Agent recherchiert die dominante Baumgruppe (Laub/Nadel/Misch)
# für die Allometrie und wählt literaturbasierte Gruppen-Koeffizienten.
VEGETATION_SPECIES_RESEARCH=true

# Satellit-Fallback wenn kein lokales DOP20-Raster vorhanden ist.
# ESRI World Imagery (schlüssellos) — Tiles werden in IMAGERY_CACHE_DIR
# gecacht, damit dieselbe AOI nicht doppelt geladen wird.
TILE_PROVIDER=esri
TILE_ZOOM=18
IMAGERY_CACHE_DIR=/app/runs/.cache/satellite

# OSM-Vegetationsdaten (natural=tree, landuse=forest, leisure=park, …)
# zur Kreuzvalidierung mit der ONNX-Kronen-Segmentierung. Fehlende OSM-
# Bäume außerhalb der ONNX-Maske werden mit Default-Krone ergänzt.
OSM_VEGETATION_ENABLED=true
OSM_TREE_DEFAULT_CROWN_M=5.0

# KI-Erweiterungen einzeln togglebar (default alle an)
REPORTING_LLM_ENABLED=true
REPORTING_LLM_USE_WEBSEARCH=true
VALIDATION_LLM_ENABLED=true
MATERIAL_LLM_ENABLED=true

# DEEPNESS multi-class segmentation: which class id represents trees/canopy.
# Set to 2 if using the LandCover.ai model (Woodland = class 2).
# Leave unset / blank for binary single-class models.
DEEPNESS_TARGET_CLASS=2

# Spec §5: Bezugsjahr der Bilanzierung. Landet im manifest.json und
# report.md-Header (Reproduzierbarkeit).
REFERENCE_YEAR=2026
